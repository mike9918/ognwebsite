{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opengamenode",
  "main": "src/index.ts",
  // Newest date supported by the Wrangler 4.156 runtime.
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ogn-waitlist",
      "database_id": "68cfe627-4fe2-4966-9c38-3dd78bca1bbd",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "opengamenode.com", "custom_domain": true },
    { "pattern": "www.opengamenode.com", "custom_domain": true }
  ],
  "vars": {
    "MIN_DISCORD_ACCOUNT_AGE_DAYS": "30"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET",
      "TURNSTILE_HOSTNAMES",
      "IP_HASH_SALT",
      "ADMIN_TOKEN",
      "ADMIN_DISCORD_IDS",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "DISCORD_INVITE_URL",
      "PUBLIC_ORIGIN"
    ]
  }
}
