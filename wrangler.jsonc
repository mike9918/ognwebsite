{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opengamenode",
  "main": "src/index.ts",
  // Newest date supported by the Wrangler 4.156 runtime.
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ogn-waitlist",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": [
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET",
      "TURNSTILE_HOSTNAMES",
      "IP_HASH_SALT",
      "ADMIN_TOKEN",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "DISCORD_INVITE_URL",
      "PUBLIC_ORIGIN"
    ]
  }
}
