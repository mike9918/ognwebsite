{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opengamenode",
  "main": "src/index.ts",
  // Newest date supported by the Wrangler 4.156 runtime.
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ogn-waitlist",
      "database_id": "68cfe627-4fe2-4966-9c38-3dd78bca1bbd",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "opengamenode.com", "custom_domain": true },
    { "pattern": "www.opengamenode.com", "custom_domain": true }
  ],
  // Safety net for a sign-up whose inline provisioning did not finish. The
  // sweep is a no-op while the panel and mail settings are missing.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Without keep_vars, `wrangler deploy` deletes every variable that is not in
  // this file — including values set in the Cloudflare dashboard. The
  // provisioning settings live in the dashboard (see README), so they must
  // survive a deploy. Secrets are stored separately and are always kept.
  "keep_vars": true,
  "vars": {
    "MIN_DISCORD_ACCOUNT_AGE_DAYS": "30",
    // Automatic vs Manual provisioning is an admin setting in D1
    // (waitlist_settings.auto_provision), not a Wrangler var.
    // The panel's Discord OAuth provider UUID, from Admin -> OAuth Providers
    // (also listed by GET /api/auth/oauth). Provisioning links each panel user
    // to their Discord id so their first sign-in lands in that account. Remove
    // it to stop linking and fall back to email sign-in wording.
    // CALAGOPUS_URL, CALAGOPUS_NEST_UUID, CALAGOPUS_EGG_*,
    // CALAGOPUS_NODE_UUID / CALAGOPUS_LOCATION_UUIDS and EMAIL_FROM are set in
    // the dashboard (locally in .dev.vars). DISCORD_WAITLIST_CHANNEL_ID is
    // optional: without it the bot posts the entry card to the guild's
    // "waitlist" channel. Secrets: CALAGOPUS_API_KEY and MS_GRAPH_* /
    // RESEND_API_KEY, via `npx wrangler secret put <NAME>`.
    "CALAGOPUS_DISCORD_PROVIDER_UUID": "609712d4-1d05-45ad-8ad9-eea05c78941a"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET",
      "TURNSTILE_HOSTNAMES",
      "IP_HASH_SALT",
      "ADMIN_TOKEN",
      "ADMIN_DISCORD_IDS",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "DISCORD_BOT_TOKEN",
      "DISCORD_GUILD_ID",
      "DISCORD_INVITE_URL",
      "PUBLIC_ORIGIN"
    ]
  }
}
